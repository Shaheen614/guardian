# ---- Runtime mode --------------------------------------------------------
# "real"  -> talk to the real Ring API via ring-client-api
# "mock"  -> generate realistic simulated doorbell/motion events (no Ring
#            account needed). Great for a first run before you have a
#            refresh token, or for CI/demo environments.
RING_MODE=mock

# ---- Ring (real mode) -----------------------------------------------------
# Generate with ring-client-api's ring-auth-cli, or via the Ring Developer
# Playground's one-click OAuth token flow. See README "Connecting real Ring".
RING_REFRESH_TOKEN=

# ---- Google Gemini (vision + agent tool-calling loop) ----------------------
# Free tier — get a key at https://aistudio.google.com/apikey. No AWS/billing
# account needed. Used by both the mcp-server's vision tool and the
# agent-gateway's tool-calling loop, so it's the only model key this project
# needs end to end.
GEMINI_API_KEY=
# Google retires Gemini models regularly. If you get a 404 "no longer
# available" error, list the models your key can use (see README
# "Troubleshooting") and update these. Fallbacks are tried in order when the
# primary model is overloaded (503) or retired (404).
GEMINI_VISION_MODEL=gemini-3.8-flash
AGENT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL_FALLBACKS=gemini-3.5-flash,gemini-flash-latest
AGENT_MODEL_FALLBACKS=gemini-3.5-flash,gemini-flash-latest

# ---- Ports -----------------------------------------------------------------
MCP_SERVER_PORT=4100
AGENT_GATEWAY_PORT=4200
MCP_SERVER_URL=http://localhost:4100/mcp

# ---- Guardian household config --------------------------------------------
# Local hour (0-23) by which the household normally sees its first event of
# the day. Used by check_household_activity_pattern to flag "unusually
# quiet" mornings. Override once you've collected a real baseline.
EXPECTED_FIRST_EVENT_HOUR=9
CAREGIVER_CONTACT_NAME=Mom

# ---- Notifications (optional, still free) ----------------------------------
# Leave blank to just log notifications to the console (zero setup). Set a
# topic to get real free push notifications via https://ntfy.sh — install
# the ntfy app or open https://ntfy.sh/<your-topic> in a browser to receive
# them. Pick a hard-to-guess topic name; ntfy topics aren't private by name.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh

# ---- Quiet hours (optional) -------------------------------------------------
# Hours in this window (local, 0-23) are never flagged as anomalies, no
# matter what the baseline says. Leave both blank to disable. Example below
# treats 11pm-6am as always-quiet.
QUIET_HOURS_START=
QUIET_HOURS_END=
