{
  "name": "@guardian/agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulated Alexa+ agent: connects to the Guardian MCP server as a real MCP client and runs a Claude tool-calling loop, exposed over a simple chat/voice HTTP API for the web client.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
