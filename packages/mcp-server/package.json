{
  "name": "@guardian/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guardian MCP server: exposes Ring doorbell/camera state, Gemini vision reasoning, and household anomaly detection as MCP tools over Streamable HTTP.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed:baseline": "tsx src/scripts/seedBaseline.ts",
    "demo:seed": "tsx src/scripts/seedDemoScenario.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ring-client-api": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
